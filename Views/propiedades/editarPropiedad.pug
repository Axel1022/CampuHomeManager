extends ../layouts/admin

block styles
    link(rel="stylesheet" href="https://unpkg.com/leaflet@1.8.0/dist/leaflet.css")

block contenido
    if errores
            div(class="max-w-md mx-auto my-10 p-4 bg-red-100 rounded-lg shadow-lg")
                each error in errores
                    p(class="bg-red-600 text-white uppercase text-xs text-center p-3 mb-2 rounded font-semibold shadow-md")= error.msg

    div(class="bg-white shadow py-8 px-4 rounded mx-auto max-w-4xl my-10 md:px-10")
        form( method="post").space-y-8
            div.space-y-2
                h3.text-lg-leading-6.font-medium.text-gray-900 Informacion General
                p.text-gray-600 Añade informacion sobre la propiedad en venta

                div
                    label.block.text-sm.uppercase.text-gray-400.mb-2.font-bold(for="titulo") Titulo de anuncio
                    input#titulo.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400(placeholder="Titulo propiedad, Ej. Casa en la playa" type="text" name="titulo" value= datos.titulo ? datos.titulo :"")

                div
                    label.block.text-sm.uppercase.text-gray-400.mb-2.font-bold(for="descripcion") Descripción
                    textarea#descripcion.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400(placeholder="Describe tu propiedad" type="text" name="descripcion" )= datos.descripcion ? datos.descripcion :""

                div(class="md:flex md:gap-4 space-y-5 md:space-y-0")

                    div(class="md:w-1/2")
                        label.block.text-sm.uppercase.text-gray-400.mb-2.font-bold(for="categoriaId") Categoria
                        select#categoria.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400( name="categoriaId")
                            option(value="") - Seleccione -
                            for categoria in Categorias
                                option(value=categoria.id selected = datos.categoriaId ? datos.categoriaId   == categoria.id ? true : false : null) #{categoria.nombre}

                    div(class="md:w-1/2")
                        label.block.text-sm.uppercase.text-gray-400.mb-2.font-bold(for="precioId") Precio
                        select#precio.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400( name="precioId")
                            option(value="") - Seleccione -
                            for precio in Precios
                                option(value=precio.id selected= datos.precioId ?  datos.precioId == precio.id ? true : false : null  ) #{precio.precio}


                div(class="md:flex md:gap-4 space-y-5 md:space-y-0")

                    div(class="md:w-1/3")
                        label.block.text-sm.uppercase.text-gray-400.mb-2.font-bold(for="habitaciones") Habitaciones
                        select#habitaciones.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400( name="habitaciones")
                            option(value="") - Seleccione -
                            - let h = 1;
                                while h <10
                                    option(value=h selected = datos.habitaciones ? datos.habitaciones == h? true : false : null ) #{h++}


                    div(class="md:w-1/3")
                        label.block.text-sm.uppercase.text-gray-400.mb-2.font-bold(for="parqueos") Estacionamientos
                        select#parqueos.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400( name="parqueos")
                            option(value="") - Seleccione -
                            - let p = 1;
                                while p <6
                                    option(value=p selected= datos.parqueos ? datos.parqueos == p ? true : false : null) #{p++}

                    div(class="md:w-1/3")
                        label.block.text-sm.uppercase.text-gray-400.mb-2.font-bold(for="banos") Baños
                        select#banos.w-full.px-3.py-2.border.border-gray-300.rounded-md.placeholder-gray-400( name="banos")
                            option(value="") - Seleccione -
                            - let b = 1;
                                while b <6
                                    option(value=b selected =  datos.banos ? datos.banos == b ? true : false : null  ) #{b++}
                div.space-y-2
                    h3.text-lg-leading-6.font-medium.text-gray-900 Ubicación
                    p.text-gray-600 Ubica la propiedad en el mapa
                    #mapa.h-96

                    div
                        p.calle= datos.calle ? datos.calle : ""
                    input(type="hidden", name="calle" id="calle" value=datos.calle ? datos.calle : "")
                    input(type="hidden", name="lat" id="lat" value= datos.lat ? datos.lat : "")
                    input(type="hidden", name="lng" id="lng" value=datos.lng ? datos.lng : "")
            input(class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-3 cursor-pointer" type="submit", value="Guardar Cambios")
block scripts
    script(src="https://unpkg.com/leaflet@1.8.0/dist/leaflet.js")
    script(src="https://unpkg.com/esri-leaflet@3.0.8/dist/esri-leaflet.js")
    script(src="https://unpkg.com/esri-leaflet-geocoder@2.2.13/dist/esri-leaflet-geocoder.js")
    script(src="https://cdnjs.cloudflare.com/ajax/libs/leaflet-geosearch/2.7.0/bundle.min.js")
    script(src="/js/mapa.js")

