  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Axel1022/CampuHomeManager/issues"
  },
  "homepage": "https://github.com/Axel1022/CampuHomeManager#readme",
  "description": "",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "CampuHomeManager": "file:",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "dropzone": "^5.9.3",
    "express": "^4.21.2",
    "express-validator": "^7.2.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.16",
    "pug": "^3.0.3",
    "sequelize": "^6.37.5",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.7",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.16",
    "webpack": "^5.97.1",
    "webpack-cli": "^5.1.4"
  }
}
